# Runtime mode: keep "demo" until real Ashai backend APIs and authentication are connected
NEXT_PUBLIC_APP_MODE=demo

# Public canonical URL used for metadata links (override in Vercel per environment)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional future integration placeholders (leave blank in demo mode; never store real secrets here)
NEXT_PUBLIC_ASHAI_API_BASE_URL=
ASHAI_SESSION_SECRET=
ASHAI_INTERNAL_API_TOKEN=
